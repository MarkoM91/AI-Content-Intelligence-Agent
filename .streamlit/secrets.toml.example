# Chiavi LLM opzionali per la modalità "AI (LLM) + Web scraper".
# Su Streamlit Cloud: Manage app → Settings → Secrets.
OPENAI_API_KEY = "sk-..."
SERPER_API_KEY = "..."
# ANTHROPIC_API_KEY = "sk-ant-..."

[gsc]
property = "https://www.example.com/"
appearance = "discover"
dimension = "page"
row_limit = 250
range_days = 90

# Copia questi valori dal token OAuth locale autorizzato.
# Non commettere mai il vero file secrets.toml.
[google_oauth]
client_id = "...apps.googleusercontent.com"
client_secret = "..."
refresh_token = "..."
token_uri = "https://oauth2.googleapis.com/token"
